# LATOKEN API credentials (get from https://latoken.com/account/apikeys)
# Needs "Trade on Spot" permission (level 2)
LATOKEN_API_KEY=your_api_key_here
LATOKEN_API_SECRET=your_api_secret_here

# Trading pair
BASE_CURRENCY=MARS
QUOTE_CURRENCY=USDT

# Strategy settings
BID_SPREAD=0.02
ASK_SPREAD=0.02
ORDER_AMOUNT=500000
ORDER_REFRESH_SECONDS=60
NUM_ORDER_LEVELS=1

# Inventory management
INVENTORY_TARGET_RATIO=0.5
INVENTORY_SKEW_FACTOR=0.5

# Safety controls
MIN_SPREAD=0.012
MAX_POSITION_USDT=5000
DAILY_LOSS_LIMIT_USDT=200
SEED_PRICE=0.007

# Volume maintenance (periodic small trades to generate executed volume)
# Set to 0 to disable
VOLUME_TRADE_INTERVAL_SECONDS=1800
VOLUME_TRADE_AMOUNT_USDT=20

# Logging
LOG_LEVEL=INFO
LOG_FILE=pmm.log
